#version 450 core
#extension GL_ARB_bindless_texture : require
in vec3 meshPosition;
flat in ivec3 meshCell;
flat in uvec2 meshMaterial;
out vec4 color;
uniform float eye[7];
uniform int meshAxes[2], target[7], targetSide, maskCount, redirector;
uniform bool lineMode;
uniform int textureExtraAxes[2];
layout(std430,binding=2) readonly buffer Faces { int textures[]; };
layout(std430,binding=3) readonly buffer Tiles { uvec2 tiles[]; };
layout(std430,binding=4) readonly buffer Masks { int masks[]; };
vec4 textureCoordinates(float hit[7], int normalAxis)
{
    // NDTF assets have four tangent coordinates: retain the 5D face basis.
    // When U is visible, substitute one hidden axis instead of shearing UVs.
    for(int extra=0;extra<2;++extra) if(textureExtraAxes[extra]>=0) {
        int axis=textureExtraAxes[extra];
        hit[axis]=hit[5+extra];
        if(normalAxis==5+extra) normalAxis=axis;
    }
    if(normalAxis==1) return fract(vec4(hit[2],1.-hit[0],hit[3],hit[4]));
    if(normalAxis==0) return fract(vec4(hit[1],1.-hit[2],hit[3],hit[4]));
    if(normalAxis==2) return fract(vec4(hit[1],1.-hit[0],hit[3],hit[4]));
    if(normalAxis==3) return fract(vec4(hit[2],1.-hit[0],hit[1],hit[4]));
    return fract(vec4(hit[2],1.-hit[0],hit[3],hit[1]));
}

void main() {
    if(lineMode){color=vec4(.1,1.,.25,1.);return;}
    int side=int(meshMaterial.y),id=int(meshMaterial.x);
    float hit[7];int p[7];float distance2=0.;
    for(int i=0;i<7;++i){hit[i]=eye[i];p[i]=int(floor(eye[i]));}
    hit[0]=meshPosition.x;hit[meshAxes[0]]=meshPosition.y;hit[meshAxes[1]]=meshPosition.z;
    p[0]=meshCell.x;p[meshAxes[0]]=meshCell.y;p[meshAxes[1]]=meshCell.z;
    if((side%2==0?-1.:1.)*(eye[side/2]-hit[side/2])<0.)discard;
    for(int i=0;i<7;++i){float delta=hit[i]-eye[i];distance2+=delta*delta;}
    float distance=sqrt(distance2);if(distance>=160.)discard;
    int tex=textures[id*14+side];
    if(id==redirector) {
        int mask=0;
        for(int m=0;m<maskCount;++m) {
            bool same=true;for(int i=0;i<7;++i)same=same && masks[m*9+i]==p[i];
            if(same){mask=masks[m*9+7];break;}
        }
        tex=(mask&(1<<side))!=0?49:48;
    }
    vec4 tangent=textureCoordinates(hit,side/2);
    vec3 coord=vec3(tangent.xy,(floor(tangent.w*16.)+tangent.z)/16.);
    vec4 sampleColor=texture(sampler3D(tiles[tex]),coord);
    if(sampleColor.a<=.001)discard;
    float light=side==1?1.:side==0?.5:.72+float(side%3)*.07;
    bool selected=targetSide==side;
    for(int i=0;i<7;++i)selected=selected && p[i]==target[i];
    if(selected)light+=.15;
    light*=.893;
    color=vec4(sampleColor.rgb*light*(1.-clamp(distance/160.,0.,1.)*.3),1.);
}
